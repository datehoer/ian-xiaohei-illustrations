# Copy to .env, fill in existing New API tokens locally, then chmod 600 .env.
# Run scripts with: uv run --env-file .env python scripts/...
MIMO_BASE_URL=https://api.hotday.uk/v1
MIMO_MODEL=mimo-v2.5-tts
MIMO_API_KEY=
XAI_BASE_URL=https://api.hotday.uk/v1
XAI_MODEL=grok-chat-fast
XAI_API_KEY=
# Optional override; Linux automatically selects the Noto Sans CJK SC face.
# VIDEO_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Optional shared model directory, passed via episode_video.py --model.
# WHISPER_MODEL=/path/to/faster-whisper-small
